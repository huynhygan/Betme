VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Same project URL/anon key, without the VITE_ prefix. Required by
# middleware.ts and api/og/[id].tsx (Vercel Edge Functions read
# process.env directly; Vite's VITE_-prefixed vars are inlined into the
# client bundle at build time and aren't available there). Set both pairs
# in the Vercel project settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=
